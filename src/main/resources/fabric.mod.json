{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${display_name}",
  "description": "${description}",
  "mixins": [
    "figurasvc-common.mixins.json"
  ],
  "authors": [
    "${authors}"
  ],
  "contact": {
    "sources": "https://github.com/AliensToEarth/FiguraSVC-compat"
  },
  "license": "LGPL-2.1",
  "icon": "assets/figurasvc/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.knownsh.figurasvc.fabric.FiguraSVCFabric"
    ],
    "figura_api": [
      "net.knownsh.figurasvc.FiguraSVC"
    ],
    "voicechat": [
      "net.knownsh.figurasvc.voice.SVCPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=1.21.8 <1.21.9",
    "figura": ">=${figura_version}"
  }
}